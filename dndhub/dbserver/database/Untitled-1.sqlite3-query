-- database: ./dndhub.db

CREATE VIEW castoro as SELECT * FROM Choice WHERE id in (
        SELECT id FROM ArrayChoiceItem WHERE array_id = 4
    );

CREATE VIEW gianfranco as SELECT * FROM OptionSet WHERE id in (
    SELECT id FROM castoro
);

SELECT * FROM gianfranco;

SELECT * FROM ArrayOptionItem WHERE array_id in (
    SELECT options_array FROM gianfranco
);